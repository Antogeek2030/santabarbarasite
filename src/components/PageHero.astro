---
const { title, text, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <div class="crumbs">
      <a href="/">Home</a>
      {crumbs.map((c: { label: string; href?: string }) => <> / {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>)}
    </div>
    <h1>{title}</h1>
    {text && <p>{text}</p>}
  </div>
</section>
