---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, SITE } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<Base title={`${s.title} in Santa Barbara, CA`} description={`${s.short} Local, licensed, and insured.`} path={`/services/${s.slug}/`}>
  <PageHero title={s.title} text={s.short} crumbs={[{ label: 'Services' }, { label: s.title }]} />
  <section class="section">
    <div class="wrap split">
      <article class="prose">
        <p class="lead">{s.intro}</p>
        <h2>Signs you may need this service</h2>
        <ul class="checks">{s.signs.map((x) => <li>{x}</li>)}</ul>
        <h2>How it works</h2>
        <ol class="steps">{s.process.map((x) => <li>{x}</li>)}</ol>
        <h2>Why it matters in Santa Barbara</h2>
        <p>{s.why}</p>
      </article>
      <aside class="side">
        <h3>Get a free quote</h3>
        <p>Call us or send a message and we will get back to you quickly.</p>
        <a class="btn btn-primary" href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a>
        <h3 style="margin-top:1.6rem">Other services</h3>
        <ul>
          {SERVICES.filter((o) => o.slug !== s.slug).map((o) => <li><a href={`/services/${o.slug}/`}>{o.title}</a></li>)}
        </ul>
      </aside>
    </div>
  </section>
  <CtaBand />
</Base>
