---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import MapSection from '../components/MapSection.astro';
import { AREAS } from '../data/site';
---
<Base title="Service Areas" description="Leak detection in Santa Barbara, Montecito, Goleta, Hope Ranch, Summerland, Carpinteria, and Isla Vista." path="/service-areas/">
  <PageHero title="Service Areas" text="Proudly serving Santa Barbara and the surrounding Central Coast communities." crumbs={[{ label: 'Service Areas' }]} />
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Where we work</h2>
        <p class="lead">We are a local company based in downtown Santa Barbara, so we can usually reach you quickly.</p>
      </div>
      <div class="grid g3">
        {AREAS.map((a) => (
          <article class="card accent"><h3>{a.name}</h3><p>{a.note}</p></article>
        ))}
      </div>
      <h2 style="margin-top:3rem">Not sure we cover your area?</h2>
      <p>If you are near Santa Barbara and need leak detection, give us a call. We often serve nearby communities and will tell you quickly if we can help.</p>
    </div>
  </section>
  <MapSection heading="Our home base" />
  <CtaBand />
</Base>
